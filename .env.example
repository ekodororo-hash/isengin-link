DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
AUTH_SECRET=isi-string-acak-panjang
# Penyimpanan foto: Supabase Storage (bucket Public). Pakai service_role key, JANGAN diberi awalan NEXT_PUBLIC_
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi-secret-key-atau-service-role-key
SUPABASE_BUCKET=isengin
NEXT_PUBLIC_SITE_URL=https://isengin.site
CRON_SECRET=isi-string-acak-panjang
# Pembayaran Midtrans (paket Pro)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxx
MIDTRANS_IS_PRODUCTION=false
PRO_PRICE_MONTH=29000
PRO_PRICE_YEAR=290000
# Domain kustom (Vercel API). VERCEL_TEAM_ID hanya bila project ada di Team
VERCEL_API_TOKEN=token-dari-vercel
VERCEL_PROJECT_ID=prj_xxxxxxxx
VERCEL_TEAM_ID=
# Keamanan link (opsional). BLOCKED_DOMAINS: daftar domain terlarang dipisah koma. SAFE_BROWSING_KEY: kunci API Google Safe Browsing
BLOCKED_DOMAINS=
SAFE_BROWSING_KEY=
# Email (verifikasi email dan lupa sandi) lewat Resend. MAIL_FROM harus memakai domain yang sudah Verified di Resend. MAIL_REPLY_TO opsional (balasan user masuk ke sini)
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM=isengin <noreply@isengin.site>
MAIL_REPLY_TO=
